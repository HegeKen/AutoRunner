<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      miuix-blur declares minSdk 31 because its RenderEffect based blur needs
      Android 12. The library degrades gracefully at runtime
      (`isRenderEffectSupported()` short circuits every effect), so AutoRunner
      keeps minSdk 28 (Android 9) and simply renders a solid panel background on
      older releases.
    -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />


    <!-- =====================================================================
         AutoRunner permissions — see §9 of the design document.
         BIND_ACCESSIBILITY_SERVICE is granted by the system when the user
         enables the service in Settings, it is not requested with the runtime
         permission API.
         ===================================================================== -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 只读网页状态页：在局域网内监听端口，供其他设备用浏览器查看。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
      黑屏挂机显示通知时，需要按包名解析任意来源应用的名称与图标。
      Android 11+ 的包可见性过滤会阻止 getApplicationInfo / getApplicationIcon，
      因此声明该权限（自动化工具需要展示所有应用的通知，用途明确）。
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".AutoRunnerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoRunner"
        android:usesCleartextTraffic="true"
        android:resizeableActivity="true">

        <!--
          小米超级岛 / 焦点通知的服务鉴权。
          APP_ID 为空时等同于未接入；申请到 APP_ID 后通过 Gradle 属性注入：
          `-Pautorunner.xiaomiXmsAppId=你的APPID`。
          BUILD_TYPE_DEBUG 只在 debug 构建为 true，用于平台侧调试设备白名单。
        -->
        <meta-data
            android:name="com.xiaomi.xms.APP_ID"
            android:value="${xmsAppId}" />
        <meta-data
            android:name="com.xiaomi.xms.BUILD_TYPE_DEBUG"
            android:value="${xmsBuildTypeDebug}" />

        <!--
          LSPosed 模块声明：本 APK 同时是「AutoRunner 超级岛解锁」模块，
          不再单独打包。入口类见 META-INF/xposed/java_init.list，模块属性见
          META-INF/xposed/module.prop；在 LSPosed 中启用本模块并勾选作用域
          （系统界面 + 小米服务框架）后生效。
        -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="允许 AutoRunner 通过小米焦点通知 / 超级岛白名单（需 LSPosed 作用域：系统界面 + 小米服务框架）" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|navigation"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Allows importing a shared .arscript file (§6.5). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/json" />
                <!-- AutoRunner's own script type; some document providers report
                     .arscript files with it once the format is known. -->
                <data android:mimeType="application/x-arscript" />
            </intent-filter>
        </activity>

        <!-- =================================================================
             Gesture recording + replay (§6.1)
             ================================================================= -->
        <service
            android:name=".accessibility.AutoRunnerAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- =================================================================
             Optional "notification access" listener: renders incoming
             notifications on the black idle screen. The user grants it in
             system settings; the root module grants it automatically.
             ================================================================= -->
        <service
            android:name=".notification.AutoRunnerNotificationListener"
            android:exported="false"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- =================================================================
             Debug only: drives the app from `adb` (MIUI blocks `input tap`).
             Disabled in release builds via the debugReceiverEnabled placeholder.
             ================================================================= -->
        <receiver
            android:name=".debug.DebugCommandReceiver"
            android:enabled="${debugReceiverEnabled}"
            android:exported="true">
            <intent-filter>
                <action android:name="cn.helilab.autorunner.DEBUG_COMMAND" />
            </intent-filter>
        </receiver>

        <!-- =================================================================
             Floating control panel (§6.4) — foreground service so that long
             repeat runs are not killed by the system.
             ================================================================= -->
        <service
            android:name=".overlay.AutoRunnerOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating control panel and progress notification for recorded automation scripts" />
        </service>

        <!-- =================================================================
             Gamepad calibration overlay — full screen transparent layer that
             lays the gamepad buttons over the real game so the user can drag
             them into place.
             ================================================================= -->
        <service
            android:name=".overlay.GamepadCalibrationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-screen gamepad button calibration overlay" />
        </service>
    </application>
</manifest>
